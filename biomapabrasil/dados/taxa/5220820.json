":"11162565","titulo":"Bothrops moojeni venom kills Leishmania spp. with hydrogen peroxide generated by its L-amino acid oxidase.","autores":["Tempone AG","Andrade HF Jr","Spencer PJ","et al."],"revista":"Biochem Biophys Res Commun","ano":2001,"aviso":null,"resolvida":true,"tipo_obra":"journal-article"},{"doi":"10.1016/j.bbrc.2006.12.217","pmid":"17292326","titulo":"Molecular approaches for structural characterization of Bothrops L-amino acid oxidases with antiprotozoal activity: cDNA cloning, comparative sequence analysis, and molecular modeling.","autores":["França SC","Kashima S","Roberto PG","et al."],"revista":"Biochem Biophys Res Commun","ano":2007,"aviso":null,"resolvida":true,"tipo_obra":"journal-article"},{"doi":"10.1016/j.ijbiomac.2007.01.006","pmid":"17320169","titulo":"Cytotoxic L-amino acid oxidase from Bothrops moojeni: biochemical and functional characterization.","autores":["Stábeli RG","Sant'Ana CD","Ribeiro PH","et al."],"revista":"Int J Biol Macromol","ano":2007,"aviso":null,"resolvida":true,"tipo_obra":"journal-article"},{"doi":"10.1186/s40409-018-0172-9","pmid":"30534149","titulo":"Kinetic investigations and stability studies of two Bothrops L-amino acid oxidases.","autores":["Costa TR","Carone SEI","Tucci LFF","et al."],"revista":"J Venom Anim Toxins Incl Trop Dis","ano":2018,"aviso":null,"resolvida":true,"tipo_obra":"journal-article"},{"doi":"10.1016/j.toxicon.2007.11.017","pmid":"18187176","titulo":"Isolation and structural characterization of a new fibrin(ogen)olytic metalloproteinase from Bothrops moojeni snake venom.","autores":["Bernardes CP","Santos-Filho NA","Costa TR","et al."],"revista":"Toxicon","ano":2008,"aviso":null,"resolvida":true,"tipo_obra":"journal-article"},{"doi":"10.1016/j.toxicon.2009.08.013","pmid":"19706302","titulo":"Structural studies of BmooMPalpha-I, a non-hemorrhagic metalloproteinase from Bothrops moojeni venom.","autores":["Akao PK","Tonoli CC","Navarro MS","et al."],"revista":"Toxicon","ano":2010,"aviso":null,"r