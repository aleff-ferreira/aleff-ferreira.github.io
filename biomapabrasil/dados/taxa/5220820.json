{"esquema":1,"id":3,"gbif":5220820,"nome":"Bothrops moojeni","autoria":"Hoge, 1966","grupo":"animal_peconhento","taxonomia":{"reino":"Animalia","filo":"Chordata","classe":"Squamata","ordem":null,"familia":"Viperidae","genero":"Bothrops"},"populares":[{"nome":"Bopeva","idioma":"por"},{"nome":"Boipeva","idioma":"por"},{"nome":"Caiçaca","idioma":"por"},{"nome":"Caiçara","idioma":"por"},{"nome":"Caissaca","idioma":"por"},{"nome":"Jaracuçu","idioma":"por"},{"nome":"Jararaca","idioma":"por"},{"nome":"Jararacão","idioma":"por"},{"nome":"Jararaca-de-Vereda","idioma":"por"},{"nome":"Jararaca-do-Cerrado","idioma":"por"},{"nome":"Jararaquinha-do-Rabo-Branco","idioma":"por"},{"nome":"Lance-headed viper","idioma":"en"}],"sinonimos":[],"origem_estabelecimento":"nativa","distribuicao_br":"registros_brasileiros_dispersos","ecologia":{"endemismo_br":null,"biomas":[],"forma_vida":"VIDA_LIVRE_INDIVIDUAL · TERRESTRE","estrato_florestal":"solo_serrapilheira","categoria_mma":null,"fonte_checklist":"Catálogo Taxonômico da Fauna do Brasil","consulta":4},"iucn":{"categoria":"LC","consulta":5},"recorte":{"dentro":true,"n_al":143,"n_al_exato":149,"n_br":1301,"n_br_com_uf":890,"n_bioma_amazonia":46,"n_ma_oeste44":3,"consulta_bioma":6,"fracao_com_uf":0.16067415730337078,"fracao_total":0.10991544965411222,"predominio":"nao_predominante","motivo":"Dentro do recorte: 143 registro(s) do GBIF na Amazônia Legal (mínimo exigido: 20). Dos 890 registro(s) brasileiros com UF atribuída, 16% estão na Amazônia Legal. 411 registro(s) do Brasil não têm UF e ficam fora dessa conta; contando-os, a fração cai para 11%. Predomínio amazônico: não, nem mesmo só entre os registros com UF. Consulta ao GBIF em 2026-11-07. Distribuição conhecida não comprova a procedência de nenhum estudo.","consulta":7,"origem_inclusao":"CTFB Fauna DwC-A × Química Aberta; Tox-Prot (UniProt); semente: protótipo anterior","correspondencia_gbif":"EXACT","confianca_gbif":99},"uf":{"BA":16,"DF":39,"GO":192,"MA":3,"MG":121,"MS":115,"MT":106,"PA":2,"PR":42,"RJ":2,"SP":220,"TO":32},"bacias":[{"id":"BAC:TAPAJOS","nome":"Tapajós–Juruena–Teles Pires","n":77,"consulta":0},{"id":"BAC:TOCANTINS","nome":"Tocantins–Araguaia–Guamá","n":57,"consulta":1},{"id":"BAC:XINGU","nome":"Xingu–Iriri","n":12,"consulta":2},{"id":"BAC:MADEIRA","nome":"Madeira–Guaporé–Aripuanã","n":1,"consulta":3}],"contexto_biocultural":[],"imagens":[{"arquivo":"imagens/5220820/1.jpg","largura":500,"altura":375,"autor":"João Vitor Oliveira de Souza","licenca":"CC BY","pagina":"https://www.gbif.org/occurrence/6147387845","instituicao":"iNaturalist","pais":"BR","v":"6a13b1","foco":[53.3,46.9],"nota":0.997}],"cobertura":{"compostos":0,"compostos_lotus":0,"compostos_nubbe":0,"compostos_npatlas":0,"consulta_lotus":8,"toxinas_fonte":11,"consulta_uniprot":9,"consulta_nubbe":null,"consulta_npatlas":null},"total_moleculas":11,"paginas_moleculas":[],"moleculas":[{"id":49,"nome":"Basic phospholipase A2 homolog myotoxin II","tipo":"proteina","classe":null,"familia":"phospholipase A2 family. Group II subfamily. K49 sub-subfamily","formula":null,"massa":null,"uniprot":"Q9I834","comprimento_aa":122,"estrutura":null,"n_publicacoes":6,"n_atividades":0,"aprovado":false,"afirmacao":{"id":49,"tipo":"funcao_toxina","estado":"candidato","evidencia":"base_curada","indice":0.5,"refs":[0,1,2,3,4,5],"procedencia":"nao_declarada","passagem":"Snake venom phospholipase A2 (PLA2) homolog that lacks enzymatic activity. Shows high myotoxin activities (PubMed:16442348, PubMed:31748642, PubMed:9637370). Also shows neurotoxicity, since it induces muscle paralysis when tested on mouse phrenic-diaphragm preparations (PubMed:16442348, PubMed:23810946, PubMed:26457430, PubMed:30679550). Displays edema-inducing activities (PubMed:16442348, PubMed:26457430, PubMed:9637370). Also displays antimicrobial activity against E.coli and C.albicans, as well as antitumoral activity against some human and mice cell lines (PubMed:16442348). In addition, it is effective as parasiticidal agent against Leishmania sp. and S.mansoni (PubMed:16442348). It also disrupts negatively charged liposomes in a dose- and temperature-dependent manner and shows toxicity by intraperitoneal route (PubMed:16442348). In contrast to other phospholipase A2-like toxins, this myotoxin does not require fatty acid binding to be active (PubMed:29287778)","experimental":true}},{"id":46,"nome":"Basic phospholipase A2 homolog MjTX-I","tipo":"proteina","classe":null,"familia":"phospholipase A2 family. Group II subfamily. K49 sub-subfamily","formula":null,"massa":null,"uniprot":"P82114","comprimento_aa":138,"estrutura":null,"n_publicacoes":4,"n_atividades":0,"aprovado":false,"afirmacao":{"id":46,"tipo":"funcao_toxina","estado":"candidato","evidencia":"base_curada","indice":0.5714,"refs":[6,7,8,9],"procedencia":"base_declara_exterior","pais_coleta":"US","passagem":"Snake venom phospholipase A2 homolog that lacks enzymatic activity (PubMed:28265084). In vivo, it displays local myotoxin and edema-inducing activities and is lethal by intraperitoneal injection (PubMed:10620318, PubMed:33865953). The myotoxicity effect is weaker in comparison to other myotoxins, probably due to the formation of high molecular weight complexes and to the oligomeric conformation (conventional dimer) (PubMed:10620318, PubMed:23573271). It shows specificity toward neurons and myotubes, but not on a variety of other cell types (PubMed:10620318, PubMed:28265084). This PLA2 excites a cohort of sensory neurons via ATP release and consequent activation of P2RX2 and/or P2RX3 purinergic receptors (PubMed:28265084). Pannexin hemichannels act as downstream mediators of toxin-evoked ATP release (PubMed:28265084). In vivo, it elicits nonneurogenic inflammatory pain, thermal hyperalgesia, and mechanical allodynia, of which the latter is completely dependent on purinergic signaling (PubMed:28265084)","experimental":true}},{"id":48,"nome":"L-amino-acid oxidase BmooLAAO-I","tipo":"proteina","classe":null,"familia":"flavin monoamine oxidase family. FIG1 subfamily","formula":null,"massa":null,"uniprot":"Q6TGQ8","comprimento_aa":502,"estrutura":null,"n_publicacoes":4,"n_atividades":0,"aprovado":false,"afirmacao":{"id":48,"tipo":"funcao_toxina","estado":"candidato","evidencia":"base_curada","indice":0.5714,"refs":[10,11,12,13],"procedencia":"base_declara_pais_pan_amazonico","pais_coleta":"BR","passagem":"Catalyzes an oxidative deamination of predominantly hydrophobic and aromatic L-amino acids, thus producing hydrogen peroxide that may contribute to the toxicity of the venom (PubMed:17320169). Shows very high activity on L-Met, and L-Leu, high activity on L-Ile, L-Phe and L-Tyr and moderate activity on L-His, L-Val and L-Ala (PubMed:17320169, PubMed:30534149). Exhibits diverse biological activities, such as edema, apoptosis of tumor cell lines, antibacterial activities against both Gram-positive and Gram-negative bacteria, as well as induction of platelet aggregation. Effects of snake L-amino oxidases on platelets are controversial, since they either induce aggregation or inhibit agonist-induced aggregation. These different effects are probably due to different experimental conditions. Unlike other snake venom L-amino acid oxidases, does not induce hemorrhage. It may also induce hemolysis. Has parasiticidal activities against and leishmania, as a result of enzyme-catalyzed hydrogen peroxide production (PubMed:11162565, PubMed:17292326)","experimental":true}},{"id":47,"nome":"Snake venom metalloproteinase BmooMPalpha-I","tipo":"proteina","classe":null,"familia":"venom metalloproteinase (M12B) family. P-I subfamily","formula":null,"massa":null,"uniprot":"P85314","comprimento_aa":218,"estrutura":null,"n_publicacoes":4,"n_atividades":0,"aprovado":false,"afirmacao":{"id":47,"tipo":"funcao_toxina","estado":"candidato","evidencia":"base_curada","indice":0.5714,"refs":[14,15,16,17],"procedencia":"base_declara_pais_pan_amazonico","pais_coleta":"BR","passagem":"Snake venom non-hemorrhagic metalloproteinase (PubMed:19706302, PubMed:31467484). Shows a preferential cleavage at Pro-Xaa bonds, which is unusual for most of characterized peptidases (PubMed:24373874). Cleaves the alpha chain of fibrinogen (FGA) first followed by the beta chain (FGB) and shows no effect on the gamma chain (PubMed:18187176). Cleaves only the beta chain of fibrin, leaving the gamma-dimer untouched (PubMed:18187176). Also cleaves neuro- and vaso-active peptides including angiotensin I, bradykinin, neurotensin oxytocin, and substance P (PubMed:24373874). In vivo, causes defibrinogenation when intraperitoneally administered on mice (PubMed:18187176)","experimental":true}},{"id":45,"nome":"Snake venom metalloproteinase BthMP","tipo":"proteina","classe":null,"familia":"venom metalloproteinase (M12B) family. P-I subfamily","formula":null,"massa":null,"uniprot":"P0DRN9","comprimento_aa":99,"estrutura":null,"n_publicacoes":2,"n_atividades":0,"aprovado":false,"afirmacao":{"id":45,"tipo":"funcao_toxina","estado":"candidato","evidencia":"base_curada","indice":0.5,"refs":[18,19],"procedencia":"nao_declarada","passagem":"Snake venom zinc metalloproteinase with high proteolytic activity on fibrin and fibrinogen (the alpha chain (FGA) is completely degraded, the beta chain (FGB) is partially degraded, while the gamma chain is not degraded) (PubMed:19000915). Inhibits cell adhesion to fibronectin and collagen IV (PubMed:41901275). In vivo, intramuscular injection induces weak hemorrhage, edema, blood incoagulability, myonecrosis, and leukocyte infiltration. Hemorrhage likely results from basement membrane degradation, while incoagulability may be due to fibrinogen breakdown (PubMed:19000915)","experimental":true}},{"id":50,"nome":"Acidic phospholipase A2 BmooPLA2","tipo":"proteina","classe":null,"familia":"phospholipase A2 family. Group II subfamily. D49 sub-subfamily","formula":null,"massa":null,"uniprot":"G3DT18","comprimento_aa":138,"estrutura":null,"n_publicacoes":1,"n_atividades":0,"aprovado":false,"afirmacao":{"id":50,"tipo":"funcao_toxina","estado":"candidato","evidencia":"base_curada","indice":0.5,"refs":[20],"procedencia":"nao_declarada","passagem":"Snake venom phospholipase A2 (PLA2) that inhibits ADP- and collagen-induced platelet aggregation, has edema-inducing, anti-coagulant activity, antibacterial activity, and cytotoxic activity. In vivo, has a hypotensive effect. PLA2 catalyzes the calcium-dependent hydrolysis of the 2-acyl groups in 3-sn-phosphoglycerides","experimental":true}},{"id":44,"nome":"Basic phospholipase A2 BmTX-I","tipo":"proteina","classe":null,"familia":"phospholipase A2 family. Group II subfamily. D49 sub-subfamily","formula":null,"massa":null,"uniprot":"P0C8M1","comprimento_aa":121,"estrutura":null,"n_publicacoes":1,"n_atividades":0,"aprovado":false,"afirmacao":{"id":44,"tipo":"funcao_toxina","estado":"candidato","evidencia":"base_curada","indice":0.5,"refs":[21],"procedencia":"nao_declarada","passagem":"Snake venom phospholipase A2 (PLA2) that shows enzymatic activity in the presence of a synthetic substrate. In vitro, blocks the neuromuscular transmission in young chick biventer cervicis preparations. In mice, induces myonecrosis and a systemic interleukin-6 response upon intramuscular injection. Also induces edema and exerts a strong pro-inflammatory effect. PLA2 catalyzes the calcium-dependent hydrolysis of the 2-acyl groups in 3-sn-phosphoglycerides","experimental":true}},{"id":54,"nome":"Bradykinin-potentiating peptide 13a","tipo":"peptideo","classe":null,"familia":"bradykinin-potentiating peptide family","formula":null,"massa":null,"uniprot":"P0C7S0","comprimento_aa":13,"estrutura":null,"n_publicacoes":1,"n_atividades":0,"aprovado":false,"afirmacao":{"id":54,"tipo":"funcao_toxina","estado":"candidato","evidencia":"base_curada","indice":0.4286,"refs":[22],"procedencia":"nao_declarada","escopo_ref":"entrada_geral","passagem":"This peptide both inhibits the activity of the angiotensin-converting enzyme (ACE) and enhances the action of bradykinin by inhibiting the peptidases that inactivate it. It acts as an indirect hypotensive agent (By similarity)","experimental":false}},{"id":52,"nome":"Disintegrin Moojecin","tipo":"proteina","classe":null,"familia":"venom metalloproteinase (M12B) family. P-II subfamily. P-IIa sub-subfamily","formula":null,"massa":null,"uniprot":"C0HMB6","comprimento_aa":69,"estrutura":null,"n_publicacoes":1,"n_atividades":0,"aprovado":false,"afirmacao":{"id":52,"tipo":"funcao_toxina","estado":"candidato","evidencia":"base_curada","indice":0.5,"refs":[23],"procedencia":"nao_declarada","passagem":"Inhibits ADP-induced platelet aggregation in human plasma, potentially via binding to ITGAV:ITGB3 (PubMed:39197621). Inhibits angiogenesis and migration of human cells in vitro (PubMed:39197621)","experimental":true}},{"id":51,"nome":"Zinc metalloproteinase-disintegrin-like moojenin","tipo":"peptideo","classe":null,"familia":"venom metalloproteinase (M12B) family. P-III subfamily. P-IIIb sub-subfamily","formula":null,"massa":null,"uniprot":"P0DKR0","comprimento_aa":33,"estrutura":null,"n_publicacoes":1,"n_atividades":0,"aprovado":false,"afirmacao":{"id":51,"tipo":"funcao_toxina","estado":"candidato","evidencia":"base_curada","indice":0.5,"refs":[24],"procedencia":"nao_declarada","passagem":"Metalloproteinase moojenin: snake venom metalloproteinase that cleaves both alpha- and beta-chains of fibrinogen, but not the gamma-chain. Shows a coagulant activity on bovine plasma about 3.1 fold lower than crude venom. Renders the blood incoagulable when intraperitoneally administered into mice. Induces necrosis in liver and muscle, but does not cause histological alterations in mouse lungs, kidney or heart","experimental":true}},{"id":53,"nome":"1370.6 Da venom vasodilator peptide","tipo":"peptideo","classe":null,"familia":null,"formula":null,"massa":null,"uniprot":"P84747","comprimento_aa":12,"estrutura":null,"n_publicacoes":0,"n_atividades":0,"aprovado":false,"afirmacao":{"id":53,"tipo":"funcao_toxina","estado":"candidato","evidencia":"base_curada","indice":0.5,"refs":[],"procedencia":"nao_declarada","passagem":"Toxin. Induces vasodilation in mice and rabbits","experimental":true}}],"refs":[{"doi":"10.1016/j.cbpc.2005.11.020","pmid":"16442348","titulo":"Bothrops moojeni myotoxin-II, a Lys49-phospholipase A2 homologue: an example of function versatility of snake venom proteins.","autores":["Stábeli RG","Amui SF","Sant'Ana CD","et al."],"revista":"Comp Biochem Physiol C Toxicol Pharmacol","ano":2006,"aviso":null,"resolvida":true,"tipo_obra":"journal-article"},{"doi":"10.1016/j.toxicon.2013.06.013","pmid":"23810946","titulo":"Structural and functional studies with mytoxin II from Bothrops moojeni reveal remarkable similarities and differences compared to other catalytically inactive phospholipases A₂-like.","autores":["Salvador GH","Cavalcante WL","Dos Santos JI","et al."],"revista":"Toxicon","ano":2013,"aviso":null,"resolvida":true,"tipo_obra":"journal-article"},{"doi":"10.1107/s1399004715014443","pmid":"26457430","titulo":"Structural and functional evidence for membrane docking and disruption sites on phospholipase A2-like proteins revealed by complexation with the inhibitor suramin.","autores":["Salvador GH","Dreyer TR","Cavalcante WL","et al."],"revista":"Acta Crystallogr D Biol Crystallogr","ano":2015,"aviso":null,"resolvida":true,"tipo_obra":"journal-article"},{"doi":"10.1016/j.bbapap.2017.12.008","pmid":"29287778","titulo":"Structural evidence for a fatty acid-independent myotoxic mechanism for a phospholipase A(2)-like toxin.","autores":["Salvador GHM","Dos Santos JI","Borges RJ","et al."],"revista":"Biochim Biophys Acta Proteins Proteom","ano":2018,"aviso":null,"resolvida":true,"tipo_obra":"journal-article"},{"doi":"10.1038/s41598-018-36839-6","pmid":"30679550","titulo":"Search for efficient inhibitors of myotoxic activity induced by ophidian phospholipase A(2)-like proteins using functional, structural and bioinformatics approaches.","autore