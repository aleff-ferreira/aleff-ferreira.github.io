ue,"n_al":91,"n_al_exato":95,"n_br":296,"n_br_com_uf":163,"n_bioma_amazonia":94,"n_ma_oeste44":0,"consulta_bioma":9,"fracao_com_uf":0.558282208588957,"fracao_total":0.30743243243243246,"predominio":"indeterminado","motivo":"Dentro do recorte: 91 registro(s) do GBIF na Amazônia Legal (mínimo exigido: 20). Dos 163 registro(s) brasileiros com UF atribuída, 56% estão na Amazônia Legal. 133 registro(s) do Brasil não têm UF e ficam fora dessa conta; contando-os, a fração cai para 31%. Predomínio amazônico: indeterminado, depende da base usada. Consulta ao GBIF em 2026-11-07. Distribuição conhecida não comprova a procedência de nenhum estudo.","consulta":10,"origem_inclusao":"CTFB Fauna DwC-A × Química Aberta; Tox-Prot (UniProt); semente: animais","correspondencia_gbif":"EXACT","confianca_gbif":100},"uf":{"AC":22,"AL":2,"AM":9,"AP":2,"BA":11,"CE":40,"ES":7,"MT":18,"PA":23,"PB":2,"PE":8,"RJ":2,"RO":6,"RR":11},"bacias":[{"id":"BAC:JURUA_PURUS","nome":"Juruá–Purus–Acre","n":25,"consulta":0},{"id":"BAC:NEGRO","nome":"Rio Negro–Branco","n":15,"consulta":1},{"id":"BAC:TAPAJOS","nome":"Tapajós–Juruena–Teles Pires","n":14,"consulta":2},{"id":"BAC:AMAZONAS_TROMBETAS","nome":"Médio e Baixo Amazonas–Trombetas–Jari–Amapá","n":11,"consulta":3},{"id":"BAC:MADEIRA","nome":"Madeira–Guaporé–Aripuanã","n":11,"consulta":4},{"id":"BAC:TOCANTINS","nome":"Tocantins–Araguaia–Guamá","n":9,"consulta":5},{"id":"BAC:XINGU","nome":"Xingu–Iriri","n":9,"consulta":6}],"contexto_biocultural":[],"imagens":[{"arquivo":"imagens/8486323/1.jpg","largura":500,"altura":375,"autor":"Cen_Bamper","licenca":"CC BY","pagina":"https://www.gbif.org/occurrence/6147568700","instituicao":"iNaturalist","pais":"EC","v":"636b1a","foco":[53.8,54.2],"nota":0.997}],"cobertura":{"compostos":0,"compostos_lotus":0,"compostos_nubbe":0,"compostos_npatlas":0,"consulta_lotus":11,"toxinas_fonte":12,"consulta_uniprot":12,"consulta_nubbe":null,"consulta_npatlas":null},"total_moleculas":12,"paginas_moleculas":[],"moleculas":[{"id":110,"nome":"Basic phospholipase A2 LmTX-I","tipo":"proteina","classe":null,"familia":"phospholipase A2 family. Group II subfamily. D49 sub-subfamily","formula":null,"massa":null,"uniprot":"P0C942","comprimento_aa":122,"estrutura":null,"n_publicacoes":4,"n_atividades":0,"aprovado":false,"afirmacao":{"id":110,"tipo":"funcao_toxina","estado":"candidato","evidencia":"base_curada","indice":0.5,"refs":[0,1,2,3],"procedencia":"nao_declarada","passagem":"Snake venom phospholipase A2 (PLA2) that displays neurotoxic and myotoxic activities. Induces inflammatory edema by mechanisms involving mast cell activation and arachidonic acid metabolites. Increases plasma creatine kinase activity. PLA2 catalyzes the calcium-dependent hydrolysis of the 2-acyl groups in 3-sn-phosphoglycerides","experimental":true}},{"id":116,"nome":"Acidic phospholipase A2 1","tipo":"peptideo","classe":null,"familia":"phospholipase A2 family. Group II subfamily. D49 sub-subfamily","formula":null,"massa":null,"uniprot":"P0C932","comprimento_aa":50,"estrutura":null,"n_publicacoes":3,"n_atividades":0,"aprovado":false,"afirmacao":{"id":116,"tipo":"funcao_toxina","estado":"candidato","evidencia":"base_curada","indice":0.5,"refs":[4,5,6],"procedencia":"nao_declarada","passagem":"Snake venom phospholipase A2 (PLA2) that displays a potent enzymatic activity as measured by indirect hemolysis of red blood cells. Is neither lethal when injected into mice nor does it present anticoagulant activity. Displays a moderate inhibitory activity on the aggregation of platelets induced by low levels of ADP, thrombin and arachidonate. In contrast, strongly inhibits platelet aggregation induced by high doses of collagen. Shows myotoxic activity, increases the plasma creatine-kinase activity and induces edema and myonecrosis of mouse skeletal muscles. PLA2 catalyzes the calcium-dependent hydrolysis of the 2-acyl groups in 3-sn-phosphoglycerides","experimental":true}},{"id":113,"nome":"Thrombin-like enzyme gyroxin analog","tipo":"proteina","classe":null,"familia":"peptidase S1 family. Snake venom subfamily","formula":null,"massa":null,"uniprot":"P33589","comprimento_aa":228,"estrutura":null,"n_publicacoes":3,"n_atividades":0,"aprovado":false,"afirmacao":{"id":113,"tipo":"funcao_toxina","estado":"candidato","evidencia":"base_curada","indice":0.5,"refs":[7,8,9],"procedencia":"nao_declarada","passagem":"Thrombin-like snake venom serine protease, that cleaves alpha-chain of fibrinogen (FGA) releases only fibrinopeptide A. Shows coagulant, esterase and amidase activities. Induces the barrel rotation syndrome in mice, which is manifested by gyroxin-like, rapid rolling motions. May also reversibly increase the permeability of the blood brain barrier (BBB) in mice","experimental":true}},{"id":115,"nome":"Bradykinin-potentiating and C-type natriuretic peptides","tipo":"proteina","classe":null,"familia":"bradykinin-potentiating peptide family","formula":null,"massa":null,"uniprot":"Q27J49","comprimento_aa":239,"estrutura":null,"n_publicacoes":2,"n_atividades":0,"aprovado":false,"afirmacao":{"id":115,"tipo":"funcao_toxina","estado":"candidato","evidencia":"base_curada","indice":0.5,"refs":[10,11],"procedencia":"nao_declarada","passagem":"Bradykinin-potentiating peptides both inhibit the activity of the angiotensin-converting enzyme (ACE) and enhances the action of bradykinin by inhibiting the peptidases that inactivate it. They act as indirect hypotensive agent (By similarity) inhibits angiotensin-converting enzyme (ACE) activity (IC(50)=4.25 uM), preventing the release of angiotensin and thus indirectly contributing to hypotension. In vivo, induce hypotensive response in both normotensive and hypertensive rats antagonizes the vasodilatory actions of bradykinin at the B2 bradykinin receptor (BDKRB2) has a vasorelaxant activity in rat aortic strips and a diuretic potency in anesthetized rats (By similarity). May act by activating natriuretic receptors (NPR1 and/or NPR2)","experimental":true}},{"id":114,"nome":"Venom plasminogen activator LV-PA","tipo":"proteina","classe":null,"familia":"peptidase S1 family. Snake venom subfamily","formula":null,"massa":null,"uniprot":"Q27J47","comprimento_aa":258,"estrutura":null,"n_publicacoes":2,"n_atividades":0,"aprovado":false,"afirmacao":{"id":114,"tipo":"funcao_toxina","estado":"candidato","evidencia":"base_curada","indice":0.5,"refs":[12,13],"procedencia":"nao_declarada","passagem":"Snake venom serine protease that activates plasminogen. Weakly hydrolyzes the alpha chain of human fibrinogen without releasing fibrinopeptide A. Does not hydrolyze plasma kallikrein or factor Xa. Does not clot fibrinogen. Does not affect platelet function. Induces hypotensive effects on rats. Shows a preferential cleavage at Lys-|-Xaa over Arg-|-Xaa bonds","experimental":true}},{"id":119,"nome":"Basic phospholipase A2 homolog LmutTX","tipo":"proteina","classe":null,"familia":"phospholipase A2 family. Group II subfamily. K49 sub-subfamily","formula":null,"massa":null,"uniprot":"P0DUN7","comprimento_aa":120,"estrutura":null,"n_publicacoes":1,"n_atividades":0,"aprovado":false,"afirmacao":{"id":119,"tipo":"funcao_toxina","estado":"candidato","evidencia":"base_curada","indice":0.5,"refs":[14],"procedencia":"nao_declarada","passagem":"Snake venom phospholipase A2 homolog that lacks enzymatic activity (PubMed:29067765). Shows moderate cytotoxicity against C2C12 myotubes (activity above 200 ug/mL) (PubMed:29067765). Also shows antibacterial activity against both Gram-positive and Gram-negative bacteria (PubMed:29067765). A model of myotoxic mechanism has been proposed: an apo Lys49-PLA2 is activated by the entrance of a hydrophobic molecule (e.g. fatty acid) at the hydrophobic channel of the protein leading to a reorientation of a monomer (By similarity). This reorientation causes a transition between 'inactive' to 'active' states, causing alignment of C-terminal and membrane-docking sites (MDoS) side-by-side and putting the membrane-disruption sites (MDiS) in the same plane, exposed to solvent and in a symmetric position for both monomers (By similarity). The MDoS region stabilizes the toxin on membrane by the interaction of charged residues with phospholipid head groups (By similarity). Subsequently, the MDiS region destabilizes the membrane with penetration of hydrophobic residues (By similarity). This insertion causes a disorganization of the membrane, allowing an uncontrolled influx of ions (i.e. calcium and sodium), and eventually triggering irreversible intracellular alterations and cell death (By similarity)","experimental":true}},{"id":118,"nome":"Basic phospholipase A2 LmTX-II","tipo":"proteina","classe":null,"familia":"phospholipase A2 family. Group II subfamily. D49 sub-subfamily","formula":null,"massa":null,"uniprot":"P0C943","comprimento_aa":122,"estrutura":null,"n_publicacoes":1,"n_atividades":0,"aprovado":false,"afirmacao":{"id":118,"tipo":"funcao_toxina","estado":"candidato","evidencia":"base_curada","indice":0.4286,"refs":[15],"procedencia":"nao_declarada","escopo_ref":"entrada_geral","passagem":"Snake venom phospholipase A2 (PLA2) that may display neurotoxic and myotoxic activities. May induce inflammatory edema by mechanisms involving mast cell activation and arachidonic acid metabolites. May increase plasma creatine kinase activity. PLA2 catalyzes the calcium-dependent hydrolysis of the 2-acyl groups in 3-sn-phosphoglycerides","experimental":false}},{"id":120,"nome":"Disintegrin lachesin","tipo":"proteina","classe":null,"familia":"venom metalloproteinase (M12B) family. P-II subfamily. P-IIa sub-subfamily","formula":null,"massa":null,"uniprot":"P31990","comprimento_aa":73,"estrutura":null,"n_publicacoes":1,"n_atividades":0,"aprovado":false,"afirmacao":{"id":120,"tipo":"funcao_toxina","estado":"candidato","evidencia":"base_curada","indice":0.4286,"refs":[16],"procedencia":"nao_declarada","escopo_ref":"entrada_geral","passagem":"Inhibits fibrinogen interaction with platelets. Acts by binding to alpha-IIb/beta-3 (ITGA2B/ITGB3) on the platelet surface and inhibits aggregation induced by ADP, thrombin, platelet-activating factor and collagen","experimental":false}},{"id":111,"nome":"Kallikrein-like enzyme LV-Ka","tipo":"proteina","classe":null,"familia":"peptidase S1 family. Snake venom subfamily","formula":null,"massa":null,"uniprot":"P0DRJ7","comprimento_aa":194,"estrutura":null,"n_publicacoes":1,"n_atividades":0,"aprovado":false,"afirmacao":{"id":111,"tipo":"funcao_toxina","estado":"candidato","evidencia":"base_curada","indice":0.5,"refs":[17],"procedencia":"nao_declarada","passagem":"Shows kallikrein-like activity, releasing bradykinin from kininogen. Also activates plasminogen, which is also a plasma kallikrein activity. Is active upon the kallikrein substrates S-2266 and S-2302, suggesting a preference for Arg in P1 position. In vivo, lowers blood pressure after intravenous injection in rat","experimental":true}},{"id":121,"nome":"Ohanin-like protein","tipo":"proteina","classe":null,"familia":"ohanin/vespryn family","formula":null,"massa":null,"uniprot":"Q27J48","comprimento_aa":218,"estrutura":null,"n_publicacoes":1,"n_atividades":0,"aprovado":false,"afirmacao":{"id":121,"tipo":"funcao_toxina","estado":"candidato","evidencia":"base_curada","indice":0.4286,"refs":[18],"procedencia":"nao_declarada","escopo_ref":"entrada_geral","passagem":"Neurotoxin that produces dose-dependent hypolocomotion and hyperalgesia in mice. May directly act on the central nervous system, as it is 6500-fold more potent when administered intracerebroventricularly than intraperitoneal","experimental":false}},{"id":117,"nome":"Phospholipase A2 2","tipo":"peptideo","classe":null,"familia":"phospholipase A2 family. Group II subfamily. D49 sub-subfamily","formula":null,"massa":null,"uniprot":"P0C933","comprimento_aa":49,"estrutura":null,"n_publicacoes":1,"n_atividades":0,"aprovado":false,"afirmacao":{"id":117,"tipo":"funcao_toxina","estado":"candidato","evidencia":"base_curada","indice":0.5,"refs":[5],"procedencia":"nao_declarada","passagem":"Snake venom phospholipase A2 (PLA2) that has a high indirect hemolytic activity and a potent inhibitory effect on platelet aggregation induced by ADP and collagen. Also produces a significant paw edema reaction in rats. This edematous response is abolished by pretreatment with either indomethacin or dexamethasone, suggesting the involvement of cyclo-oxygenase. May be myotoxic. PLA2 catalyzes the calcium-dependent hydrolysis of the 2-acyl groups in 3-sn-phosphoglycerides","experimental":true}},{"id":112,"nome":"Snake venom metalloproteinase hemorrhagic factor 2","tipo":"proteina","classe":null,"familia":"venom metalloproteinase (M12B) family. P-I subfamily","formula":null,"massa":null,"uniprot":"P22796","comprimento_aa":200,"estrutura":null,"n_publicacoes":1,"n_atividades":0,"aprovado":false,"afirmacao":{"id":112,"tipo":"funcao_toxina","estado":"candidato","evidencia":"base_curada","indice":0.5,"refs":[19],"procedencia":"nao_declarada","passagem":"Snake venom zinc metalloproteinase that induces weak hemorrhage and mild myonecrosis. Shows mild myotoxicity by killing myocytes. Also induces edema in the mouse footpad at doses where hemorrhage is absent. In vitro, degrades laminin, fibronectin, and type IV collagen, suggesting this toxin play a role in local tissue damage by degrading extracellular matrix, and possibly by degrading muscle extracellular matrix. Hemorrhage is not due to cytotoxicity towards endothelial cells in culture, and may only play a minor role in local bleeding characteristic of L.muta envenomations. Also induces the synthesis of several endogenous matrix metalloproteinases, which in turn, may participate in extracellular matrix degradation","experimental":true}}],"refs":[{"doi":"10.1016/j.toxicon.2006.02.007","pmid":"16626776","titulo":"Functional characterization of a basic D49 phospholipase A2 (LmTX-I) from the venom of the snake Lachesis muta muta (bushmaster).","autores":["Damico DC","Bueno LG","Rodrigues-Simioni L","et al."],"revista":"Toxicon","ano":2006,"aviso":null,"resolvida":true,"tipo_obra":"journal-article"},{"doi":"10.1016/j.toxicon.2006.11.014","pmid":"17208264","titulo":"Cytotoxicity of Lachesis muta muta snake (bushmaster) venom and its purified basic phospholipase A2 (LmTX-I) in cultured cells.","autores":["Damico DC","Nascimento JM","Lomonte B","et al."],"revista":"Toxicon","ano":2007,"aviso":null,"resolvida":true,"tipo_obra":"journal-article"},{"doi":"10.1007/s10930-008-9148-x","pmid":"18766430","titulo":"Pharmacological study of edema and myonecrosis in mice induced by venom of the bushmaster snake (Lachesis muta muta) and its basic Asp49 phospholipase A(2) (LmTX-I).","autores":["Damico DC","da Cruz Höfling MA","Cintra M","et al."],"revista":"Protein J","ano":2008,"aviso":null,"resolvida":true,"tipo_obra":"journal-article"},{"doi":"10.1016/j.toxicon.2008.10.016","pmid":"18996140","titulo":"Inflammatory oedema induced by Lachesis muta muta (Surucucu) venom and LmTX-I in the rat paw and dorsal skin.","autores":["Ferreira T","Camargo EA","Ribela MT","et al."],"revista":"Toxicon","ano":2009,"aviso":null,"resolvida":true,"tipo_obra":"journal-article"},{"doi":"10.1016/s0041-0101(99)00208-1","pmid":"10728833","titulo":"Myotoxic activity of an acidic phospholipase A2 isolated from Lachesis muta (Bushmaster) snake venom.","autores":["Fuly AL","Calil-Elias S","Zingali RB","et al."],"revista":"Toxicon","ano":2000,"aviso":null,"resolvida":true,"tipo_obra":"journal-article"},{"doi":"10.1016/s0006-2952(02)00873-0","pmid":"12007562","titulo":"Purification and characterization of a phospholipase A2 isoenzyme isolated from Lachesis muta snake venom.","autores":["Fuly AL","de Miranda AL","Zingali RB","et al."],"revista":"Biochem Pharmacol","ano":2002,"aviso":null,"resolvida":true,"tipo_obra":"journal-article"},{"doi":"10.1055/s-0038-1665414","pmid":"9408022","titulo":"Mechanism of inhibitory action on platelet activation of a phospholipase A2 isolated 