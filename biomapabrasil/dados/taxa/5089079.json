má","n":730,"consulta":0},{"id":"BAC:TAPAJOS","nome":"Tapajós–Juruena–Teles Pires","n":19,"consulta":1},{"id":"BAC:XINGU","nome":"Xingu–Iriri","n":5,"consulta":2},{"id":"BAC:AMAZONAS_TROMBETAS","nome":"Médio e Baixo Amazonas–Trombetas–Jari–Amapá","n":3,"consulta":3},{"id":"BAC:MADEIRA","nome":"Madeira–Guaporé–Aripuanã","n":1,"consulta":4}],"contexto_biocultural":[],"imagens":[{"arquivo":"imagens/5089079/1.jpg","largura":640,"altura":640,"autor":"Ray Wilson, Liverpool School of Tropical Medicine","licenca":"CC BY","pagina":"https://commons.wikimedia.org/wiki/File:Lutzomyia_longipalpis-sandfly.jpg","instituicao":"Wikimedia Commons","v":"566b18","foco":[50.2,54.0],"nota":1.0}],"cobertura":{"compostos":5,"compostos_lotus":5,"compostos_nubbe":0,"compostos_npatlas":0,"consulta_lotus":9,"toxinas_fonte":3,"consulta_uniprot":10,"consulta_nubbe":null,"consulta_npatlas":null},"total_moleculas":8,"paginas_moleculas":[],"moleculas":[{"id":124,"nome":"Lufaxin","tipo":"proteina","classe":null,"familia":null,"formula":null,"massa":null,"uniprot":"Q5WPU8","comprimento_aa":301,"estrutura":null,"n_publicacoes":3,"n_atividades":0,"aprovado":false,"afirmacao":{"id":124,"tipo":"funcao_toxina","estado":"candidato","evidencia":"base_curada","indice":0.5,"refs":[0,1,2],"procedencia":"nao_declarada","passagem":"Sand fly salivary protein with antithrombotic, and anti-complement (alternative pathway) activities (PubMed:22796577, PubMed:28912782, PubMed:36947859). Is a slow, tight, non-competitive, and reversible inhibitor of factor Xa (FXa, F10) (PubMed:22796577). Is specific for FXa (Kd=3.86 nM) and does not interact with non-activated FX, or all other enzymes tested (PubMed:22796577). In addition, it blocks prothrombinase and increases both prothrombin time and activated partial thromboplastin time (PubMed:22796577). It also prevents protease-activated receptor 2 (F2RL1, PAR2) activation by FXa (PubMed:22796577). In vivo, it abrogates edema formation triggered by injection of FXa in the paw of mice (PubMed:22796577). Moreover, it prevents FeCl(3)-induced carotid artery thrombus formation and prolongs activated partial thromboplastin time ex vivo, implying that it works as an anticoagulant in vivo (PubMed:22796577). It also inhibits the early steps of the alternative pathway of complement by direct binding to the proconvertase C3b-B complex, by inhibiting activation of factor B and consequently the formation of the C3 convertase (PubMed:28912782)","experimental":true}},{"id":125,"nome":"Salivary anti-complement protein","tipo":"proteina","classe":null,"familia":null,"formula":null,"massa":null,"uniprot":"Q5WPZ4","comprimento_aa":115,"estrutura":null,"n_publicacoes":2,"n_atividades":0,"aprovado":false,"afirmacao":{"id":125,"tipo":"funcao_toxina","estado":"candidato","evidencia":"base_curada","indice":0.5,"refs":[3,4],"procedencia":"nao_declarada","passagem":"Salivary protein that inhibits the classical pathway of complement system activation in the host while having no inhibitory effect on the alternative or lectin pathways (PubMed:26758086, PubMed:28278244). Prevent cleavage of host C4 and consequently impairs the activation of factors downstream of C4b in the complement cascade (PubMed:26758086)","experimental":true}},{"id":123,"nome":"Salivary endonuclease","tipo":"proteina","classe":null,"familia":"DNA/RNA non-specific endonuclease family","formula":null,"massa":null,"uniprot":"Q5WPS9","comprimento_aa":409,"estrutura":null,"n_publicacoes":2,"n_atividades":0,"aprovado":false,"afirmacao":{"id":123,"tipo":"funcao_toxina","estado":"candidato","evidencia":"base_curada","indice":0.5,"refs":[5,6],"procedencia":"nao_declarada","passagem":"Hydrolyzes single-stranded and double-stranded DNA with little sequence specificity (PubMed:24516388). Inhibits contact pathway of blood coagulation in the host by preventing activation of coagulation factor XII (F12) triggered by soluble DNA (PubMed:24516388). Modestly up-regulates expression of CSF2, CXCL1 and CXCL8 in cultured human dermal microvascular endothelial cells (PubMed:29723281). At higher doses promotes host neutrophil recruitment at the injection site in mouse model (PubMed:29723281) (Microbial infection) Increases Leishmania major survival in the host by disrupting parasite-induced neutrophil extracellular traps (PubMed:24516388). Exacerbates L.major parasite infectivity and increases cutaneous lesions in mouse model (PubMed:24516388)","experimental":true}},{"id":1296,"nome":"(-)-alpha-Himachalene","tipo":"pequena_molecula","classe":"Terpenoids › Himachalane sesquiterpenoids","familia":null,"formula":"C15H24","massa":204.19,"uniprot":null,"comprimento_aa":null,"estrutura":"estruturas_lotes/87.json#ZJSIKVDEOWWVEH-KBPBESRZSA-N","n_publicacoes":1,"n_atividades":0,"aprovado":false,"afirmacao":{"id":24428,"tipo":"composto_em_organismo","estado":"candidato","evidencia":"artigo_cita_organismo","indice":0.4286,"refs":[7],"procedencia":"nao_declarada"}},{"id":12412,"nome":"(1E,5E,10R)-1,5,10-trimethyl-8-propan-2-ylidenecyclodeca-1,5-diene","tipo":"pequena_molecula","classe":"Terpenoids › Germacrane sesquiterpenoids","familia":null,"formula":"C16H26","massa":218.2,"uniprot":null,"comprimento_aa":null,"estrutura":"estruturas_lotes/3a.json#MBOZYHRSVMIYRG-HGMOOEGUSA-N","n_publicacoes":1,"n_atividades":0,"aprovado":false,"afirmacao":{"id":24429,"tipo":"composto_em_organismo","estado":"candidato","evidencia":"artigo_cita_organismo","indice":0.4286,"refs":[8],"procedencia":"nao_declarada"}},{"id":12413,"nome":"(1S,6S)-alpha-himachalene","tipo":"pequena_molecula","classe":"Terpenoids › Himachalane sesquiterpenoids","familia":null,"formula":"C15H24","massa":204.19,"uniprot":null,"comprimento_aa":null,"estrutura":"estruturas_lotes/1e.json#ZJSIKVDEOWWVEH-KGLIPLIRSA-N","n_publicacoes":1,"n_atividades":0,"aprovado":false,"afirmacao":{"id":24430,"tipo":"composto_em_organismo","estado":"candidato","evidencia":"artigo_cita_organismo","indice":0.4286,"refs":[7],"procedencia":"nao_declarada"}},{